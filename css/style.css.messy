/* =================================================================
   QUATTRO HOMES — MASTER STYLESHEET
   Base: clean white + light grey  |  Accents: gold + forest green
   Dark mode: near-black base, same accent rules
   Chrome (nav, hero, footer): always dark forest green
   ================================================================= */

/* ── Tokens ─────────────────────────────────────────────────────── */
:root {
  /* Accent palette — same in both modes */
  --gold:          #c8a15c;
  --gold-light:    #ddb978;
  --gold-subtle:   rgba(200,161,92,0.12);
  --forest:        #1c3626;
  --forest-deep:   #12241a;

  /* Light mode page */
  --bg:            #ffffff;
  --bg-subtle:     #f5f5f5;
  --bg-card:       #ffffff;
  --text:          #111111;
  --text-mid:      #444444;
  --text-muted:    #777777;
  --text-faint:    #aaaaaa;
  --border:        #e0e0e0;
  --border-mid:    #cccccc;
  --shadow-sm:     0 1px 4px rgba(0,0,0,0.06);
  --shadow-md:     0 4px 16px rgba(0,0,0,0.08);
  --shadow-lg:     0 8px 32px rgba(0,0,0,0.10);
  --input-bg:      #f9f9f9;

  /* Buttons — light mode */
  --btn-bg:        #111111;
  --btn-fg:        #ffffff;
  --btn-bg-h:      #2a2a2a;

  --radius:   5px;
  --radius-lg: 10px;
}

/* ── Reset ───────────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Jost', system-ui, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
  transition: background .25s, color .25s;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }
img { display: block; max-width: 100%; }
h1,h2,h3,h4 {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 600; line-height: 1.15; color: var(--text);
}

/* ── Layout ──────────────────────────────────────────────────────── */
.container { max-width: 1100px; margin: 0 auto; padding: 0 28px; }
section { padding: 88px 0; }
.bg-subtle-section { background: var(--bg-subtle); }

.section-head { text-align: center; max-width: 640px; margin: 0 auto 56px; }
.section-head h2 { font-size: clamp(2rem, 4vw, 2.8rem); margin: 8px 0 14px; }
.section-head p { color: var(--text-muted); font-size: 1rem; line-height: 1.7; }

.eyebrow {
  display: inline-block;
  font-size: 0.72rem; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.22em;
  color: var(--gold);
}

/* ── Buttons ─────────────────────────────────────────────────────── */
.btn {
  display: inline-block; padding: 13px 30px;
  border-radius: var(--radius); font-family: 'Jost', sans-serif;
  font-size: 0.88rem; font-weight: 600; letter-spacing: 0.04em;
  border: 1.5px solid transparent; cursor: pointer;
  transition: background .18s, color .18s, border-color .18s, transform .15s;
}
.btn:hover { transform: translateY(-1px); }

.btn-primary {
  background: var(--btn-bg); color: var(--btn-fg); border-color: var(--btn-bg);
}
.btn-primary:hover { background: var(--btn-bg-h); border-color: var(--btn-bg-h); }

.btn-gold {
  background: var(--gold); color: #111; border-color: var(--gold);
}
.btn-gold:hover { background: var(--gold-light); border-color: var(--gold-light); }

.btn-outline {
  background: transparent; color: var(--text); border-color: var(--border-mid);
}
.btn-outline:hover { border-color: var(--gold); color: var(--gold); }

/* on dark photo backgrounds */
.btn-outline-light {
  background: rgba(255,255,255,0.1);
  color: #fff; border-color: rgba(255,255,255,0.5);
}
.btn-outline-light:hover { border-color: var(--gold-light); color: var(--gold-light); }

/* ── NAV ────────────────────────────────────────────────────────── */
header.site-header {
  position: sticky; top: 0; z-index: 100;
}
.nav-inner {
  max-width: 1100px; margin: 0 auto;
  display: flex; align-items: center;
  justify-content: space-between;
  padding: 0 28px; height: 66px;
  position: relative;
}
.brand { display: flex; align-items: center; gap: 11px; color: #f5ede0; }
.brand .mark {
  width: 36px; height: 36px; border-radius: 50%;
  border: 1.5px solid var(--gold);
  display: flex; align-items: center; justify-content: center;
  font-family: 'Cormorant Garamond', serif;
  color: var(--gold); font-size: 1.1rem; font-weight: 600;
}
.brand .name {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.3rem; letter-spacing: 0.04em; line-height: 1.2;
}
.brand .name small {
  display: block; font-family: 'Jost', sans-serif;
  font-size: 0.55rem; letter-spacing: 0.28em;
  color: var(--gold-light); text-transform: uppercase;
}
nav.links {
  display: flex; align-items: center; gap: 28px;
}
nav.links a {
  font-size: 0.84rem; color: rgba(245,237,224,0.72);
  letter-spacing: 0.03em; transition: color .2s; padding: 4px 0;
}
nav.links a:hover, nav.links a.active { color: var(--gold-light); }
.nav-right { display: flex; align-items: center; gap: 10px; }
.nav-cta {
  background: var(--gold); color: #111 !important;
  padding: 9px 20px; border-radius: var(--radius);
  font-weight: 700; font-size: 0.82rem; letter-spacing: 0.03em;
  border: none; transition: background .18s;
}
.nav-cta:hover { background: var(--gold-light); transform: none; }
.theme-btn {
  background: none; border: 1px solid rgba(200,161,92,0.4);
  color: var(--gold-light); width: 34px; height: 34px;
  border-radius: 50%; font-size: 0.82rem; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background .15s;
}
.theme-btn:hover { background: rgba(200,161,92,0.1); }
.lang-btn {
  background: none; border: 1px solid rgba(200,161,92,0.4);
  color: var(--gold-light); padding: 6px 12px;
  border-radius: var(--radius); font-size: 0.74rem;
  letter-spacing: 0.05em; cursor: pointer; font-family: inherit;
}
.lang-btn:hover { background: rgba(200,161,92,0.1); }
.nav-toggle-btn {
  display: none; flex-direction: column; justify-content: center;
  gap: 5px; width: 38px; height: 38px;
  background: none; border: none; cursor: pointer;
}
.nav-toggle-btn span {
  display: block; width: 22px; height: 2px;
  background: #f5ede0; border-radius: 2px;
}
.nav-cta-mobile { display: none; }
@media (max-width: 900px) {
  .nav-toggle-btn { display: flex; }
  .nav-cta-desktop { display: none; }
  .nav-cta-mobile { display: block; width: 100%; text-align: center; margin: 14px 0 18px; }
  nav.links {
    position: absolute; top: 100%; left: 0; right: 0;
    background: var(--forest-deep); flex-direction: column;
    align-items: stretch; gap: 0; max-height: 0; overflow: hidden;
    transition: max-height .3s ease;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  nav.links.open { max-height: 500px; }
  nav.links a { padding: 15px 28px; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 0.95rem; }
}

/* ── HERO ────────────────────────────────────────────────────────── */
.hero {
  position: relative; height: 92svh; min-height: 560px;
  display: flex; align-items: center; justify-content: center;
  text-align: center; overflow: hidden; isolation: isolate;
  color: #fff;
}
.hero-slides { position: absolute; inset: 0; z-index: -2; }
.hero-slide {
  position: absolute; inset: 0;
  background-size: cover; background-position: center;
  opacity: 0; transition: opacity 1.6s ease;
}
.hero-slide.active { opacity: 1; }
.hero-overlay {
  position: absolute; inset: 0; z-index: -1;
  background: linear-gradient(
    to bottom,
    rgba(0,0,0,0.25) 0%,
    rgba(0,0,0,0.52) 55%,
    rgba(0,0,0,0.78) 100%
  );
}
.hero-content { position: relative; z-index: 1; padding: 0 24px; max-width: 760px; }
.hero-eyebrow {
  font-size: 0.72rem; font-weight: 600; letter-spacing: 0.28em;
  color: var(--gold-light); text-transform: uppercase; margin-bottom: 16px;
}
.hero h1 {
  font-size: clamp(2.8rem, 7vw, 5rem);
  color: #ffffff; font-weight: 500; margin-bottom: 18px;
}
.hero h1 em { font-style: italic; color: var(--gold-light); }
.hero .lede {
  font-size: 1.1rem; color: rgba(255,255,255,0.78);
  max-width: 500px; margin: 0 auto 32px; font-weight: 300; line-height: 1.7;
}
.hero-scroll-cta {
  display: inline-block; padding: 14px 34px;
  background: var(--gold); color: #111;
  border-radius: var(--radius); font-weight: 700;
  font-size: 0.9rem; letter-spacing: 0.04em;
  transition: background .18s, transform .15s;
  border: none;
}
.hero-scroll-cta:hover { background: var(--gold-light); transform: translateY(-2px); }
.hero-dots {
  position: absolute; bottom: 28px; left: 50%; transform: translateX(-50%);
  display: flex; gap: 8px; z-index: 2;
}
.hero-dots button {
  width: 7px; height: 7px; border-radius: 50%; border: none;
  background: rgba(255,255,255,0.35); cursor: pointer; padding: 0;
  transition: background .2s, transform .2s;
}
.hero-dots button.active { background: var(--gold-light); transform: scale(1.4); }

/* ── PHOTO MOSAIC ────────────────────────────────────────────────── */
.photos-section { padding-bottom: 0; }
.photos-mosaic {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  grid-template-rows: 280px 280px;
  gap: 5px; margin-top: 0;
}
.mosaic-item {
  position: relative; overflow: hidden; display: block;
  background: var(--bg-subtle);
}
.mosaic-item img {
  width: 100%; height: 100%; object-fit: cover;
  transition: transform .5s ease;
}
.mosaic-item:hover img { transform: scale(1.05); }
.mosaic-large { grid-row: 1 / 3; }
.mosaic-label {
  position: absolute; bottom: 0; left: 0; right: 0;
  background: linear-gradient(transparent, rgba(0,0,0,0.55));
  color: rgba(255,255,255,0.9); font-size: 0.75rem;
  letter-spacing: 0.04em; padding: 24px 14px 10px;
  opacity: 0; transition: opacity .3s;
}
.mosaic-item:hover .mosaic-label { opacity: 1; }
@media (max-width: 760px) {
  .photos-mosaic {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 200px 200px 200px;
  }
  .mosaic-large { grid-row: 1; grid-column: 1 / 3; }
}
@media (max-width: 480px) {
  .photos-mosaic { grid-template-rows: 180px 140px 140px; gap: 3px; }
}

/* ── AMENITIES — light subtle cards ─────────────────────────────── */
.amenities-section { background: var(--bg-subtle); }
.amenities-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 14px;
}
.amenity-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 22px 20px;
  display: flex; align-items: center; gap: 14px;
  box-shadow: var(--shadow-sm);
  transition: border-color .2s, box-shadow .2s;
}
.amenity-card:hover { border-color: var(--gold); box-shadow: var(--shadow-md); }
.amenity-card i {
  font-size: 1.2rem; color: var(--gold); flex-shrink: 0; width: 20px; text-align: center;
}
.amenity-card span { font-size: 0.9rem; font-family: 'Jost', sans-serif; color: var(--text-mid); font-weight: 500; }
@media (max-width: 600px) { .amenities-grid { grid-template-columns: 1fr 1fr; } }

/* ── TWO FLOORS ──────────────────────────────────────────────────── */
.floors-section { background: var(--bg); }
.floors-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 28px;
}
.floor-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg); overflow: hidden;
  box-shadow: var(--shadow-md);
  transition: transform .2s, box-shadow .2s;
}
.floor-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
.floor-img {
  position: relative; height: 240px; overflow: hidden;
}
.floor-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
.floor-card:hover .floor-img img { transform: scale(1.04); }
.floor-badge {
  position: absolute; top: 14px; left: 14px;
  background: var(--gold); color: #111;
  font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em;
  padding: 5px 12px; border-radius: 20px; text-transform: uppercase;
}
.floor-body { padding: 26px 28px 30px; }
.floor-body h3 { font-size: 1.5rem; margin-bottom: 10px; }
.floor-body p { font-size: 0.93rem; color: var(--text-muted); margin-bottom: 22px; line-height: 1.65; }
@media (max-width: 680px) { .floors-grid { grid-template-columns: 1fr; } }

/* ── SUITED FOR ──────────────────────────────────────────────────── */
.suited-section { }
.suited-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 12px; max-width: 900px; margin: 0 auto;
}
.suited-item {
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 16px 18px;
  display: flex; align-items: center; gap: 12px;
  font-size: 0.92rem; font-weight: 500; color: var(--text-mid);
  box-shadow: var(--shadow-sm);
}
.check { color: var(--gold); font-weight: 700; font-size: 1rem; flex-shrink: 0; }

/* ── REFERRAL ────────────────────────────────────────────────────── */
.referral-section { padding: 56px 0; background: var(--bg); }
.referral-card {
  max-width: 820px; margin: 0 auto;
  background: var(--gold-subtle);
  border: 1px solid rgba(200,161,92,0.3);
  border-radius: var(--radius-lg);
  padding: 32px 36px;
  display: flex; align-items: flex-start; gap: 22px;
}
.referral-icon {
  flex-shrink: 0; width: 50px; height: 50px;
  border-radius: 50%; border: 1.5px solid var(--gold);
  display: flex; align-items: center; justify-content: center;
  color: var(--gold); font-size: 1.3rem;
}
.referral-card h3 { font-size: 1.35rem; margin-bottom: 8px; color: var(--text); }
.referral-card p  { font-size: 0.93rem; color: var(--text-muted); line-height: 1.65; }
@media (max-width: 560px) {
  .referral-card { flex-direction: column; align-items: center; text-align: center; padding: 26px 22px; }
}

/* ── BOOKING / FORM ──────────────────────────────────────────────── */
.booking-section { background: var(--bg-subtle); }
.booking-grid {
  display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 40px; align-items: start;
}
@media (max-width: 860px) { .booking-grid { grid-template-columns: 1fr; } }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
@media (max-width: 560px) { .form-row { grid-template-columns: 1fr; } }
.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
.field label { font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); font-weight: 600; }
.field input, .field select, .field textarea {
  padding: 11px 13px; border: 1px solid var(--border);
  border-radius: var(--radius); font-family: inherit;
  font-size: 0.94rem; background: var(--input-bg); color: var(--text);
  transition: border-color .2s;
}
.field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: var(--gold); }
.field textarea { resize: vertical; min-height: 90px; }
.submit-btn {
  width: 100%; background: var(--btn-bg); color: var(--btn-fg);
  border: none; padding: 14px; border-radius: var(--radius);
  font-size: 0.95rem; font-weight: 600; letter-spacing: 0.03em;
  cursor: pointer; font-family: inherit; transition: opacity .2s;
}
.submit-btn:hover { opacity: 0.85; }
.submit-btn:disabled { opacity: 0.5; cursor: not-allowed; }
#form-feedback {
  margin-top: 16px; padding: 12px 16px;
  border-radius: var(--radius); font-size: 0.9rem; display: none;
}
#form-feedback.success { display:block; background:#edf7ee; color:#1a4a22; border:1px solid #b8d9bc; }
#form-feedback.error   { display:block; background:#fdf0ef; color:#8a2f22; border:1px solid #f0c4bc; }

/* ── CALENDAR ────────────────────────────────────────────────────── */
.calendar-card h3 { margin: 0 0 16px; font-size: 1.25rem; }
.cal-floor-tabs { display: flex; gap: 6px; margin-bottom: 14px; }
.cal-floor-tab {
  flex: 1; background: var(--input-bg); border: 1px solid var(--border);
  color: var(--text); padding: 8px 6px; border-radius: var(--radius);
  font-size: 0.78rem; font-weight: 600; cursor: pointer; font-family: inherit;
  transition: background .15s, color .15s, border-color .15s;
}
.cal-floor-tab.active, .cal-floor-tab:hover { background: var(--gold); color: #111; border-color: var(--gold); }
.cal-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.cal-nav button {
  background: none; border: 1px solid var(--border); border-radius: var(--radius);
  width: 32px; height: 32px; cursor: pointer; color: var(--text); font-family: inherit;
}
.cal-month-label { font-family: 'Cormorant Garamond', serif; font-size: 1.1rem; color: var(--text); }
.cal-grid { display: grid; grid-template-columns: repeat(7,1fr); gap: 3px; text-align: center; }
.cal-grid .dow { font-size: 0.65rem; color: var(--text-faint); text-transform: uppercase; padding-bottom: 6px; }
.cal-day { padding: 9px 0; font-size: 0.84rem; border-radius: var(--radius); color: var(--text); }
.cal-day.empty   { visibility: hidden; }
.cal-day.past    { color: var(--text-faint); }
.cal-day.booked  { background: rgba(180,60,50,0.1); color: #b43c32; text-decoration: line-through; }
.cal-day.available { background: var(--gold-subtle); }
.legend { display: flex; gap: 16px; margin-top: 14px; font-size: 0.76rem; color: var(--text-muted); }
.legend span { display: inline-flex; align-items: center; gap: 6px; }
.legend i { width: 11px; height: 11px; border-radius: 2px; display: inline-block; }
.legend .i-avail  { background: var(--gold-subtle); border: 1px solid var(--border); }
.legend .i-booked { background: rgba(180,60,50,0.12); }
.price-summary {
  display: flex; justify-content: space-between; align-items: center;
  background: var(--gold-subtle); border: 1px dashed var(--gold);
  border-radius: var(--radius); padding: 12px 16px; margin-bottom: 16px; font-size: 0.9rem;
}
.cal-grid-wrap { position: relative; min-height: 60px; }
.cal-loading {
  position: absolute; inset: 0; background: rgba(255,255,255,0.7);
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--radius); z-index: 2;
}

/* ── PRICING ─────────────────────────────────────────────────────── */
.pricing-card {
  max-width: 440px; margin: 0 auto;
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: var(--radius-lg); padding: 44px 40px; text-align: center;
  box-shadow: var(--shadow-lg);
}
.price-amount {
  font-family: 'Cormorant Garamond', serif;
  font-size: 2.8rem; color: var(--text); margin-bottom: 22px;
}
.price-amount span { font-size: 1rem; color: var(--text-muted); font-family: 'Jost', sans-serif; }
.price-includes { list-style: none; margin: 0 0 22px; text-align: left; }
.price-includes li { padding: 9px 0; border-bottom: 1px solid var(--border); font-size: 0.93rem; }
.price-includes li::before { content: "✓ "; color: var(--gold); font-weight: 700; }
.price-note { font-size: 0.79rem; color: var(--text-faint); }
.price-discount-badge {
  display: inline-block; margin-top: 14px;
  background: var(--gold-subtle); color: var(--gold);
  border: 1px solid rgba(200,161,92,0.3);
  font-size: 0.78rem; font-weight: 600; padding: 6px 14px; border-radius: 20px;
}

/* ── GALLERY ─────────────────────────────────────────────────────── */
.gallery-tabs { display: flex; justify-content: center; gap: 10px; margin-bottom: 30px; }
.gallery-tab {
  background: var(--bg-card); border: 1px solid var(--border); color: var(--text);
  padding: 9px 24px; border-radius: 20px; font-size: 0.85rem; font-weight: 600;
  cursor: pointer; font-family: inherit; transition: all .2s;
}
.gallery-tab.active, .gallery-tab:hover { background: var(--gold); color: #111; border-color: var(--gold); }
.gallery-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 16px; }
.gallery-grid img {
  width: 100%; height: 320px; object-fit: cover;
  border-radius: var(--radius); cursor: zoom-in; transition: transform .3s;
}
.gallery-grid img:hover { transform: scale(1.015); }
@media (max-width: 700px) { .gallery-grid { grid-template-columns: 1fr; } .gallery-grid img { height: 220px; } }

/* ── TESTIMONIALS ────────────────────────────────────────────────── */
.testimonial-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px,1fr)); gap: 22px; }
.testimonial-card {
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 28px; box-shadow: var(--shadow-sm);
}
.testimonial-card .stars { color: var(--gold); margin-bottom: 12px; font-size: 0.9rem; letter-spacing: 2px; }
.testimonial-card p {
  font-family: 'Cormorant Garamond', serif; font-style: italic;
  font-size: 1.08rem; line-height: 1.55; color: var(--text); margin: 0 0 14px;
}
.testimonial-name { font-size: 0.78rem; color: var(--text-muted); }
.review-toggle summary {
  cursor: pointer; text-align: center; font-weight: 600; color: var(--text);
  list-style: none; padding: 12px; border: 1px dashed var(--gold); border-radius: var(--radius);
}
.review-toggle summary::-webkit-details-marker { display: none; }
.star-rating { display: flex; gap: 6px; }
.star-rating button {
  background: none; border: none; font-size: 1.8rem; color: var(--text-faint);
  cursor: pointer; padding: 2px; transition: color .15s;
}
.star-rating button.active { color: var(--gold); }

/* ── ABOUT ───────────────────────────────────────────────────────── */
.about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
@media (max-width: 860px) { .about-grid { grid-template-columns: 1fr; } }
.about-img img { width: 100%; border-radius: var(--radius-lg); display: block; }
.about-copy p { color: var(--text-muted); margin-bottom: 18px; line-height: 1.7; }
.about-stats { display: flex; gap: 36px; margin-top: 26px; }
.about-stats div { display: flex; flex-direction: column; }
.about-stats strong { font-family: 'Cormorant Garamond', serif; font-size: 1.8rem; color: var(--gold); }
.about-stats span { font-size: 0.75rem; color: var(--text-faint); text-transform: uppercase; letter-spacing: 0.05em; }

/* ── BLOG ────────────────────────────────────────────────────────── */
.blog-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px,1fr)); gap: 26px; margin-bottom: 40px; }
.blog-card {
  display: block; background: var(--bg-card); border: 1px solid var(--border);
  border-radius: var(--radius-lg); overflow: hidden;
  box-shadow: var(--shadow-sm); transition: transform .2s, box-shadow .2s;
}
.blog-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
.blog-card img { width: 100%; height: 190px; object-fit: cover; }
.blog-card-body { padding: 20px 22px 24px; }
.blog-date { font-size: 0.7rem; color: var(--gold); text-transform: uppercase; letter-spacing: 0.06em; }
.blog-card-body h3 { font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; color: var(--text); margin: 8px 0 8px; }
.blog-card-body p { font-size: 0.88rem; color: var(--text-muted); margin: 0 0 14px; }
.blog-read-more { font-size: 0.82rem; color: var(--gold); font-weight: 600; }
.blog-article { max-width: 720px; margin: 0 auto; }
.blog-article h1 { font-size: clamp(1.9rem,4vw,2.6rem); }
.blog-article-cover { width: 100%; border-radius: var(--radius); margin-bottom: 28px; }
.blog-article-body { font-size: 1rem; line-height: 1.8; color: var(--text-muted); }
.blog-article-body h2 { font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; margin: 32px 0 12px; color: var(--text); }
.blog-article-body p { margin: 0 0 18px; }

/* ── FAQ ─────────────────────────────────────────────────────────── */
.faq-list { max-width: 720px; margin: 0 auto; }
.faq-item { border-bottom: 1px solid var(--border); padding: 18px 0; }
.faq-item summary {
  cursor: pointer; font-weight: 600; color: var(--text);
  list-style: none; position: relative; padding-right: 28px; font-size: 0.97rem;
}
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item summary::after  { content: "+"; position: absolute; right: 0; top: 0; color: var(--gold); font-size: 1.3rem; font-weight: 300; }
.faq-item[open] summary::after { content: "–"; }
.faq-item p { margin: 12px 0 4px; color: var(--text-muted); font-size: 0.92rem; }

/* ── HOUSE RULES ─────────────────────────────────────────────────── */
.rules-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap: 16px; max-width: 900px; margin: 0 auto; }
.rule-item {
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 18px 20px;
  display: flex; flex-direction: column; gap: 4px; box-shadow: var(--shadow-sm);
}
.rule-item strong { color: var(--text); font-size: 0.92rem; }
.rule-item span { font-size: 0.84rem; color: var(--text-muted); }

/* ── CONTACT (always dark chrome) ───────────────────────────────── */
.contact-section { background: var(--forest); color: #f5ede0; }
.contact-section .section-head h2 { color: #f5ede0; }
.contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap: 24px; max-width: 900px; margin: 0 auto; }
.contact-card {
  border: 1px solid rgba(200,161,92,0.22); border-radius: var(--radius);
  padding: 28px; text-align: center;
  transition: border-color .2s;
}
.contact-card:hover { border-color: rgba(200,161,92,0.55); }
.contact-card .icon { font-size: 1.5rem; color: var(--gold-light); margin-bottom: 12px; }
.contact-card h4 { color: #f5ede0; margin: 0 0 7px; font-family: 'Jost', sans-serif; font-size: 0.95rem; letter-spacing: 0.03em; }
.contact-card p, .contact-card a { color: rgba(245,237,224,0.72); font-size: 0.92rem; }
.contact-card a.whatsapp-link { color: var(--gold-light); font-weight: 600; }

/* ── MAP ─────────────────────────────────────────────────────────── */
.map-embed { margin-top: 44px; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); }

/* ── FOOTER (always dark chrome) ────────────────────────────────── */
footer {
  background: var(--forest-deep); color: rgba(245,237,224,0.5);
  padding: 28px 0; font-size: 0.82rem;
}
.footer-inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; }
.footer-inner .socials a { margin-left: 16px; color: rgba(245,237,224,0.55); transition: color .2s; }
.footer-inner .socials a:hover { color: var(--gold-light); }

/* ── LIGHTBOX ────────────────────────────────────────────────────── */
.lightbox-overlay {
  position: fixed; inset: 0; background: rgba(5,8,6,0.96);
  z-index: 2000; display: none; align-items: center; justify-content: center; padding: 24px;
}
.lightbox-overlay.open { display: flex; }
.lightbox-overlay img { max-width: 90vw; max-height: 82vh; border-radius: 4px; box-shadow: 0 10px 40px rgba(0,0,0,0.6); }
.lightbox-close, .lightbox-nav {
  position: absolute; background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2); color: #fff; border-radius: 50%;
  width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;
  cursor: pointer; font-size: 1.1rem; transition: background .15s;
}
.lightbox-close { top: 20px; right: 20px; }
.lightbox-nav.prev { left: 20px; top: 50%; transform: translateY(-50%); }
.lightbox-nav.next { right: 20px; top: 50%; transform: translateY(-50%); }
.lightbox-close:hover, .lightbox-nav:hover { background: rgba(255,255,255,0.2); }
.lightbox-counter { position: absolute; bottom: 22px; left: 50%; transform: translateX(-50%); color: rgba(255,255,255,0.55); font-size: 0.8rem; }

/* ── LOADING ─────────────────────────────────────────────────────── */
.spinner {
  display: inline-block; width: 14px; height: 14px;
  border: 2px solid rgba(0,0,0,0.12); border-top-color: var(--text);
  border-radius: 50%; animation: spin .7s linear infinite;
  vertical-align: -2px; margin-right: 8px;
}

@keyframes spin { to { transform: rotate(360deg); } }
.admin-loading-bar {
  position: fixed; top: 0; left: 0; height: 3px; width: 0%;
  background: var(--gold); z-index: 9999; transition: width .4s ease;
}
.admin-loading-bar.active { width: 70%; }

/* ── WHATSAPP FLOAT ──────────────────────────────────────────────── */
.whatsapp-float {
  position: fixed; bottom: 24px; right: 24px;
  width: 58px; height: 58px; background: #25D366; color: #fff;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 1.7rem; box-shadow: 0 6px 20px rgba(0,0,0,0.2);
  z-index: 999; animation: wa-pulse 2.5s infinite; transition: transform .15s;
}
.whatsapp-float:hover { transform: scale(1.08); }
@keyframes wa-pulse {
  0%,100% { box-shadow: 0 6px 20px rgba(0,0,0,0.2), 0 0 0 0 rgba(37,211,102,0.45); }
  60%      { box-shadow: 0 6px 20px rgba(0,0,0,0.2), 0 0 0 14px rgba(37,211,102,0); }
}

/* ── REFERRAL APPLIED NOTE ───────────────────────────────────────── */
.referral-applied-note {
  display: flex; align-items: center; gap: 8px;
  background: var(--gold-subtle); color: var(--text);
  border: 1px solid rgba(200,161,92,0.3);
  padding: 10px 14px; border-radius: var(--radius); font-size: 0.85rem; margin-bottom: 16px;
}

/* ── MISC ────────────────────────────────────────────────────────── */
.hp-field { position: absolute; left: -9999px; top: -9999px; height: 0; overflow: hidden; }

.card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 30px; box-shadow: var(--shadow-sm); }


/* ══════════════════════════════════════════════════════
   NAV — adaptive light/dark (not always dark chrome)
   ══════════════════════════════════════════════════════ */
header.site-header {
  background: var(--forest);           /* light mode: dark forest */
  border-bottom: 1px solid rgba(255,255,255,0.06);
}

/* ══════════════════════════════════════════════════════
   COMBINED BOOKING SECTION
   ══════════════════════════════════════════════════════ */
.book-combined { background: var(--bg-subtle); }

.combined-grid {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 32px;
  align-items: start;
}
@media (max-width: 860px) { .combined-grid { grid-template-columns: 1fr; } }

.combined-sub {
  font-family: 'Jost', sans-serif;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: var(--text-muted);
  margin: 0 0 14px;
}

/* Suited big cards — 3-per-row, icon + label, generous padding */
.suited-big-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
.suited-big-item {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px 14px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  text-align: center;
  font-size: 0.86rem;
  font-weight: 500;
  color: var(--text-mid);
  box-shadow: var(--shadow-sm);
  transition: border-color .2s, box-shadow .2s, transform .15s;
  cursor: default;
}
.suited-big-item:hover {
  border-color: var(--gold);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}
.suited-big-item i {
  font-size: 1.4rem;
  color: var(--gold);
}
@media (max-width: 500px) {
  .suited-big-grid { grid-template-columns: repeat(2, 1fr); }
}

/* Quick date picker inside combined section */
.quick-pick { margin-top: 4px; }
.quick-pick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 10px;
}
@media (max-width: 500px) { .quick-pick-grid { grid-template-columns: 1fr 1fr; } }
.qp-field {
  display: flex; flex-direction: column; gap: 5px;
}
.qp-field label {
  font-size: 0.7rem; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.1em;
  color: var(--text-muted);
}
.qp-field select,
.qp-field input {
  padding: 9px 10px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-family: inherit; font-size: 0.88rem;
  background: var(--input-bg); color: var(--text);
  transition: border-color .2s;
  appearance: none; -webkit-appearance: none;
}
.qp-field select:focus,
.qp-field input:focus { outline: none; border-color: var(--gold); }

/* ══════════════════════════════════════════════════════
   PRICING SECTION (on homepage)
   ══════════════════════════════════════════════════════ */
.pricing-section { background: var(--bg); }

/* ══════════════════════════════════════════════════════
   FOOTER — full redesign
   ══════════════════════════════════════════════════════ */

.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1.2fr;
  gap: 48px;
  padding-bottom: 56px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
@media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; gap: 36px; } }
@media (max-width: 520px)  { .footer-grid { grid-template-columns: 1fr; gap: 28px; } }

/* Brand column */
.footer-brand {}
.footer-logo {
  display: flex; align-items: center; gap: 12px;
  text-decoration: none; margin-bottom: 16px;
}
.footer-logo .mark {
  width: 38px; height: 38px; border-radius: 50%;
  border: 1.5px solid var(--gold);
  display: flex; align-items: center; justify-content: center;
  font-family: 'Cormorant Garamond', serif;
  color: var(--gold); font-size: 1.1rem; font-weight: 600;
  flex-shrink: 0;
}
.footer-name {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.2rem; color: #f5ede0; display: block; line-height: 1.2;
}
.footer-logo small {
  font-family: 'Jost', sans-serif;
  font-size: 0.55rem; color: var(--gold-light);
  letter-spacing: 0.22em; text-transform: uppercase;
}
.footer-tagline {
  font-size: 0.88rem; color: rgba(245,237,224,0.5);
  line-height: 1.65; max-width: 260px; margin-bottom: 20px;
}

.footer-socials {
  display: flex; gap: 10px;
}
.footer-socials a {
  width: 36px; height: 36px; border-radius: 50%;
  border: 1px solid rgba(200,161,92,0.3);
  display: flex; align-items: center; justify-content: center;
  color: rgba(245,237,224,0.6); font-size: 0.88rem;
  transition: background .2s, color .2s, border-color .2s;
}
.footer-socials a:hover {
  background: rgba(200,161,92,0.12);
  color: var(--gold-light); border-color: var(--gold);
}

/* Link columns */
.footer-col h5 {
  font-family: 'Jost', sans-serif;
  font-size: 0.7rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.18em;
  color: var(--gold-light); margin-bottom: 16px;
}
.footer-col a {
  display: flex; align-items: center; gap: 8px;
  color: rgba(245,237,224,0.6); font-size: 0.86rem;
  margin-bottom: 10px; transition: color .2s;
}
.footer-col a:hover { color: #f5ede0; }
.footer-col a i { width: 14px; text-align: center; font-size: 0.82rem; color: var(--gold); flex-shrink: 0; }

/* Share row */
.footer-share {
  display: flex; gap: 8px; margin-top: 4px;
}
.footer-share a {
  width: 32px; height: 32px; border-radius: var(--radius);
  border: 1px solid rgba(200,161,92,0.25);
  display: flex; align-items: center; justify-content: center;
  color: rgba(245,237,224,0.55); font-size: 0.82rem;
  margin-bottom: 0;
  transition: background .2s, color .2s, border-color .2s;
}
.footer-share a:hover {
  background: rgba(200,161,92,0.12);
  color: var(--gold-light); border-color: var(--gold);
}

/* Bottom bar */
.footer-bottom {
  padding: 18px 0;
}
.footer-bottom-inner {
  display: flex; justify-content: space-between;
  align-items: center; flex-wrap: wrap; gap: 10px;
  font-size: 0.78rem; color: rgba(245,237,224,0.35);
}
.footer-bottom-links {
  display: flex; gap: 20px;
}
.footer-bottom-links a {
  color: rgba(245,237,224,0.35); transition: color .2s;
}
.footer-bottom-links a:hover { color: var(--gold-light); }
@media (max-width: 520px) {
  .footer-bottom-inner { flex-direction: column; text-align: center; }
  .footer-bottom-links { justify-content: center; }
}

/* ══════════════════════════════════════════════════════
   NAV — light mode only, forest green background
   ══════════════════════════════════════════════════════ */
header.site-header {
  background: var(--forest);
  border-bottom: 1px solid rgba(255,255,255,0.07);
}

/* ══════════════════════════════════════════════════════
   SUITED BIG CARDS — fill calendar height, 3-col, large
   ══════════════════════════════════════════════════════ */
.combined-grid {
  display: grid;
  grid-template-columns: 1fr 1.05fr;
  gap: 28px;
  align-items: stretch; /* both columns same height */
}
.combined-left {
  display: flex;
  flex-direction: column;
}
.suited-big-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  flex: 1; /* fill remaining height */
}
.suited-big-item {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  text-align: center;
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--text-mid);
  box-shadow: var(--shadow-sm);
  transition: border-color .2s, box-shadow .2s, transform .15s;
  cursor: default;
  min-height: 100px; /* ensure uniform height */
  flex: 1;
}
.suited-big-item:hover {
  border-color: var(--gold);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}
.suited-big-item i {
  font-size: 1.6rem;
  color: var(--gold);
}
.suited-big-item span {
  font-size: 0.85rem;
  padding: 0 8px;
  line-height: 1.3;
}
@media (max-width: 500px) {
  .suited-big-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 860px) {
  .combined-grid { grid-template-columns: 1fr; }
  .suited-big-item { min-height: 90px; }
}

/* Remove the old quick-pick CSS (no longer used) */
.quick-pick, .quick-pick-grid, .qp-field { display: none !important; }

/* ══════════════════════════════════════════════════════
   AMENITY CARDS — bigger, 4-col, icon on top + description
   ══════════════════════════════════════════════════════ */
.amenities-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}
.amenity-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 10px;
  box-shadow: var(--shadow-sm);
  transition: border-color .2s, box-shadow .2s, transform .15s;
}
.amenity-card:hover {
  border-color: var(--gold);
  box-shadow: var(--shadow-md);
  transform: translateY(-3px);
}
.amenity-card i {
  font-size: 1.8rem;
  color: var(--gold);
}
.amenity-card strong {
  font-family: 'Jost', sans-serif;
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text);
}
.amenity-card span {
  font-size: 0.8rem;
  color: var(--text-muted);
  line-height: 1.4;
}
@media (max-width: 860px) { .amenities-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 480px)  { .amenities-grid { grid-template-columns: repeat(2, 1fr); } }

/* ══════════════════════════════════════════════════════
   REVIEWS SECTION
   ══════════════════════════════════════════════════════ */
.reviews-section { background: var(--bg-subtle); }

/* ══════════════════════════════════════════════════════
   TERMS & CONDITIONS page prose
   ══════════════════════════════════════════════════════ */
.prose h2 {
  font-size: 1.25rem;
  margin: 32px 0 10px;
  color: var(--text);
  font-family: 'Cormorant Garamond', serif;
}
.prose p {
  color: var(--text-muted);
  font-size: 0.95rem;
  line-height: 1.75;
  margin-bottom: 16px;
}
.terms-link {
  color: var(--gold);
  text-decoration: underline;
  text-underline-offset: 2px;
}

/* ══════════════════════════════════════════════════════
   T&C CHECKBOX in booking form
   ══════════════════════════════════════════════════════ */
.terms-field { margin-top: 4px; }
.checkbox-label {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  cursor: pointer;
  font-size: 0.88rem;
  color: var(--text-muted);
  line-height: 1.5;
}
.checkbox-label input[type="checkbox"] {
  width: 16px; height: 16px;
  margin-top: 2px; flex-shrink: 0;
  accent-color: var(--forest);
  cursor: pointer;
}

/* ══════════════════════════════════════════════════════
   COOKIE CONSENT BANNER
   ══════════════════════════════════════════════════════ */
#cookie-banner {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  z-index: 9000;
  background: var(--forest-deep);
  color: rgba(245,237,224,0.85);
  padding: 18px 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
  font-size: 0.85rem;
  line-height: 1.55;
  box-shadow: 0 -4px 20px rgba(0,0,0,0.25);
  transform: translateY(100%);
  transition: transform .4s ease;
}
#cookie-banner.visible { transform: translateY(0); }
#cookie-banner a { color: var(--gold-light); text-decoration: underline; text-underline-offset: 2px; }
.cookie-actions { display: flex; gap: 10px; flex-shrink: 0; }
.cookie-accept {
  background: var(--gold); color: #111;
  border: none; padding: 9px 22px;
  border-radius: var(--radius); font-size: 0.85rem;
  font-weight: 700; cursor: pointer; font-family: inherit;
  transition: background .18s;
}
.cookie-accept:hover { background: var(--gold-light); }
.cookie-decline {
  background: transparent;
  color: rgba(245,237,224,0.6);
  border: 1px solid rgba(245,237,224,0.25);
  padding: 9px 18px;
  border-radius: var(--radius); font-size: 0.85rem;
  cursor: pointer; font-family: inherit;
  transition: color .18s, border-color .18s;
}
.cookie-decline:hover { color: rgba(245,237,224,0.9); border-color: rgba(245,237,224,0.5); }
@media (max-width: 600px) {
  #cookie-banner { flex-direction: column; align-items: flex-start; padding: 18px 20px 20px; }
  .cookie-actions { width: 100%; }
  .cookie-accept, .cookie-decline { flex: 1; text-align: center; }
}

/* ══════════════════════════════════════════════════════
   GALLERY PAGE
   ══════════════════════════════════════════════════════ */

/* Page header */
.gallery-page-header {
  background: var(--forest);
  padding: 48px 0 36px;
  color: #f5ede0;
  text-align: center;
}
.gallery-page-header .eyebrow { color: var(--gold-light); }
.gallery-page-header h1 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(2.2rem, 5vw, 3.4rem);
  color: #f5ede0;
  font-weight: 500;
  margin: 8px 0 12px;
}
.gallery-page-header p {
  color: rgba(245,237,224,0.65);
  font-size: 1rem;
  font-weight: 300;
}

/* Sticky tab bar */
.gallery-tab-bar {
  position: sticky;
  top: 66px; /* nav height */
  z-index: 40;
  background: #fff;
  border-bottom: 1px solid var(--border);
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
.gallery-tab-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 0;
  padding-bottom: 0;
  height: 58px;
  gap: 16px;
}
.gallery-tabs {
  display: flex;
  gap: 4px;
  height: 100%;
  align-items: stretch;
}
.gallery-tab {
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  padding: 0 20px;
  font-family: 'Jost', sans-serif;
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--text-muted);
  cursor: pointer;
  transition: color .2s, border-color .2s;
  display: flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
  height: 100%;
  border-radius: 0;
}
.gallery-tab:hover { color: var(--text); border-bottom-color: var(--border-mid); }
.gallery-tab.active {
  color: var(--forest);
  font-weight: 700;
  border-bottom-color: var(--gold);
}
.tab-count {
  font-size: 0.72rem;
  font-weight: 400;
  color: var(--text-faint);
}
.gallery-tab.active .tab-count { color: var(--gold); }
.gallery-book-btn {
  flex-shrink: 0;
  padding: 9px 22px;
  font-size: 0.84rem;
  background: var(--gold) !important;
  color: #111 !important;
  border-color: var(--gold) !important;
  font-weight: 700;
}
.gallery-book-btn:hover {
  background: var(--gold-light) !important;
  border-color: var(--gold-light) !important;
}

/* Masonry panel */
.masonry-panel {
  padding: 32px 0 16px;
  background: var(--bg-subtle);
}
.masonry-grid {
  columns: 3;
  column-gap: 10px;
  padding: 0 28px;
  max-width: 1280px;
  margin: 0 auto;
}
.masonry-item {
  break-inside: avoid;
  position: relative;
  margin-bottom: 10px;
  border-radius: var(--radius);
  overflow: hidden;
  cursor: pointer;
  background: var(--border);
}
.masonry-item img {
  width: 100%;
  height: auto;
  display: block;
  transition: transform .4s ease;
}
.masonry-item:hover img { transform: scale(1.04); }
.masonry-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 50%);
  opacity: 0;
  transition: opacity .3s;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 14px;
}
.masonry-item:hover .masonry-overlay { opacity: 1; }
.masonry-label {
  color: rgba(255,255,255,0.92);
  font-size: 0.78rem;
  letter-spacing: 0.03em;
  font-weight: 500;
}
.masonry-zoom {
  color: var(--gold-light);
  font-size: 1.1rem;
}

@media (max-width: 900px) {
  .masonry-grid { columns: 2; }
}
@media (max-width: 520px) {
  .masonry-grid { columns: 1; padding: 0 16px; }
  .gallery-tab-inner { justify-content: center; }
  .gallery-book-btn { display: none; }
  .gallery-tabs { gap: 0; }
  .gallery-tab { padding: 0 12px; font-size: 0.82rem; }
}

/* CTA strip */
.gallery-cta-strip {
  background: var(--forest);
  padding: 52px 0;
}
.gallery-cta-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
  flex-wrap: wrap;
}
.gallery-cta-inner h3 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.8rem;
  color: #f5ede0;
  margin-bottom: 6px;
}
.gallery-cta-inner p {
  color: rgba(245,237,224,0.6);
  font-size: 0.92rem;
}
.gallery-cta-btns {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}
.gallery-cta-btns .btn-outline {
  border-color: rgba(245,237,224,0.4);
  color: #f5ede0;
}
.gallery-cta-btns .btn-outline:hover {
  border-color: var(--gold-light);
  color: var(--gold-light);
}
@media (max-width: 700px) {
  .gallery-cta-inner { flex-direction: column; text-align: center; }
  .gallery-cta-btns { justify-content: center; }
}

/* Lightbox */
.lightbox-overlay {
  position: fixed; inset: 0;
  background: rgba(5,8,6,0.97);
  z-index: 2000;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
}
.lightbox-overlay.open { display: flex; }
.lb-img-wrap {
  position: relative;
  max-width: 90vw;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}
#lb-img {
  max-width: 90vw;
  max-height: 80vh;
  object-fit: contain;
  border-radius: 3px;
  box-shadow: 0 12px 48px rgba(0,0,0,0.7);
  display: block;
}
.lb-caption {
  margin-top: 12px;
  color: rgba(255,255,255,0.6);
  font-size: 0.82rem;
  letter-spacing: 0.04em;
  text-align: center;
}
.lightbox-close {
  position: fixed; top: 18px; right: 20px;
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  color: #fff; border-radius: 50%;
  width: 42px; height: 42px;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; font-size: 1rem;
  transition: background .15s;
  z-index: 10;
}
.lightbox-close:hover { background: rgba(255,255,255,0.2); }
.lightbox-nav {
  position: fixed; top: 50%; transform: translateY(-50%);
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.18);
  color: #fff; border-radius: 50%;
  width: 48px; height: 48px;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; font-size: 1rem;
  transition: background .15s;
  z-index: 10;
}
.lightbox-nav:hover { background: rgba(255,255,255,0.2); }
.lightbox-nav.prev { left: 16px; }
.lightbox-nav.next { right: 16px; }
.lightbox-counter {
  position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
  color: rgba(255,255,255,0.45);
  font-size: 0.78rem; letter-spacing: 0.06em;
}
@media (max-width: 600px) {
  .lightbox-nav { width: 38px; height: 38px; font-size: 0.9rem; }
  .lightbox-nav.prev { left: 8px; }
  .lightbox-nav.next { right: 8px; }
}

/* ══════════════════════════════════════════════════════
   PAGE HEADER (shared — about, contact, gallery)
   ══════════════════════════════════════════════════════ */
.page-header {
  padding: 56px 0 44px;
  text-align: center;
}
.bg-forest { background: var(--forest); }
.page-header .eyebrow { margin-bottom: 10px; }
.page-header h1 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(2.2rem, 5vw, 3.6rem);
  color: #f5ede0;
  font-weight: 500;
  line-height: 1.1;
  margin: 8px 0 12px;
}
.page-header p {
  color: rgba(245,237,224,0.65);
  font-size: 1.02rem;
  font-weight: 300;
  max-width: 520px;
  margin: 0 auto;
}


/* ══════════════════════════════════════════════════════
   CONTACT PAGE — cards
   ══════════════════════════════════════════════════════ */
.wa-cta-section { padding: 56px 0; background: var(--bg); }
.wa-cta-card {
  max-width: 820px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 32px;
  background: #fff;
  border: 2px solid #25D366;
  border-radius: var(--radius-lg);
  padding: 40px 44px;
  box-shadow: 0 4px 24px rgba(37,211,102,0.12);
}
.wa-cta-icon {
  font-size: 4.5rem;
  color: #25D366;
  flex-shrink: 0;
  line-height: 1;
}
.wa-cta-body h3 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.6rem;
  color: var(--text);
  margin-bottom: 10px;
}
.wa-cta-body p {
  color: var(--text-muted);
  font-size: 0.96rem;
  margin-bottom: 22px;
  line-height: 1.7;
}
.btn-wa {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  background: #25D366;
  color: #fff;
  padding: 12px 28px;
  border-radius: var(--radius);
  font-weight: 700;
  font-size: 0.9rem;
  transition: background .18s, transform .15s;
  border: none;
}
.btn-wa:hover { background: #1ebe5d; transform: translateY(-1px); }
@media (max-width: 640px) {
  .wa-cta-card { flex-direction: column; align-items: center; text-align: center; padding: 32px 24px; }
  .btn-wa { width: 100%; justify-content: center; }
}

.contact-cards-section { padding: 56px 0; background: var(--bg); }
.contact-info-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
@media (max-width: 860px) { .contact-info-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 480px)  { .contact-info-grid { grid-template-columns: 1fr 1fr; } }

.contact-info-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 32px 24px;
  text-align: center;
  box-shadow: var(--shadow-sm);
  transition: border-color .2s, box-shadow .2s, transform .15s;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.contact-info-card:hover {
  border-color: var(--gold);
  box-shadow: var(--shadow-md);
  transform: translateY(-3px);
}
.cic-icon {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--gold-subtle);
  border: 1px solid rgba(200,161,92,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  color: var(--gold);
  margin-bottom: 16px;
  flex-shrink: 0;
}
.contact-info-card h4 {
  font-family: 'Jost', sans-serif;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 8px;
}
.contact-info-card p {
  font-size: 0.95rem;
  color: var(--text);
  font-weight: 500;
  margin-bottom: 14px;
  line-height: 1.4;
}
.cic-link {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--gold);
  text-decoration: underline;
  text-underline-offset: 2px;
  transition: color .2s;
  margin-top: auto;
}
.cic-link:hover { color: var(--forest); }

.faq-section { padding: 72px 0 88px; background: var(--bg-subtle); }
.faq-two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 48px;
  max-width: 960px;
  margin: 0 auto;
}
@media (max-width: 700px) { .faq-two-col { grid-template-columns: 1fr; } }

/* ══════════════════════════════════════════════════════
   ABOUT PAGE — cards
   ══════════════════════════════════════════════════════ */
.values-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
@media (max-width: 860px) { .values-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 480px)  { .values-grid { grid-template-columns: 1fr 1fr; } }

.value-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 32px 24px;
  box-shadow: var(--shadow-sm);
  transition: border-color .2s, box-shadow .2s, transform .15s;
}
.value-card:hover {
  border-color: var(--gold);
  box-shadow: var(--shadow-md);
  transform: translateY(-3px);
}
.value-icon {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--gold-subtle);
  border: 1px solid rgba(200,161,92,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
  color: var(--gold);
  margin-bottom: 18px;
}
.value-card h4 {
  font-family: 'Jost', sans-serif;
  font-size: 1rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 10px;
}
.value-card p {
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.7;
}

.floor-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 14px;
}
.floor-tags span {
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 4px 12px;
  font-size: 0.76rem;
  font-weight: 500;
  color: var(--text-muted);
}

.location-list {
  list-style: none;
  padding: 0;
  margin: 18px 0 0;
}
.location-list li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 0.93rem;
  color: var(--text-mid);
  margin-bottom: 10px;
}
.location-list li i { color: var(--gold); margin-top: 3px; flex-shrink: 0; }

.bg-forest-cta { background: var(--forest); padding: 72px 0; }
