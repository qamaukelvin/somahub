# Somahub — subdomain routing
# Point *.somahub.top (wildcard DNS A record) at this same hosting directory,
# and this rewrites subdomain requests to the correct school automatically.

RewriteEngine On

# Bare domain or www — goes to the homepage
RewriteCond %{HTTP_HOST} ^(www\.)?somahub\.top$ [NC]
RewriteRule ^$ index.php [L]

# Any school subdomain's root request — route to site.php BEFORE the generic
# file/directory passthrough below, otherwise this rule is never reached
# (an empty path always "exists" as the docroot directory, so the passthrough
# would silently swallow every subdomain request first).
RewriteCond %{HTTP_HOST} ^([a-z0-9-]+)\.somahub\.top$ [NC]
RewriteRule ^$ site.php?school=%1 [L,QSA]

# Real files/folders that exist (css, images, other scripts, /admin/, /dashboard/, etc.)
# — applies on any host, subdomain or not, for any path other than the bare root above
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Also allow /schoolname style paths as a fallback if wildcard DNS/hosting isn't working
# e.g. somahub.top/s/kinangoppride
RewriteRule ^s/([a-z0-9-]+)/?$ site.php?school=$1 [L,QSA]
