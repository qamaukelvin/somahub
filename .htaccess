# Somahub — subdomain routing
# Point *.somahub.top (wildcard DNS A record) at this same hosting directory,
# and this rewrites subdomain requests to the correct school automatically.

# Never serve internal files from the web root
<FilesMatch "(?i)(\.(sql|md|ini|log|bak|dist|example\.php)$|^composer\.(json|lock)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
Options -Indexes

# Speed: compression + browser caching for static assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

RewriteEngine On

# Force HTTPS on every host (bare domain + all school subdomains)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www -> apex (one canonical host for search engines)
RewriteCond %{HTTP_HOST} ^www\.somahub\.top$ [NC]
RewriteRule ^(.*)$ https://somahub.top/$1 [L,R=301]

# Host-aware robots.txt and sitemap (each school subdomain gets its own)
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Bare domain — goes to the homepage
RewriteCond %{HTTP_HOST} ^somahub\.top$ [NC]
RewriteRule ^$ index.php [L]

# Any school subdomain's root request — route to site.php BEFORE the generic
# file/directory passthrough below, otherwise this rule is never reached
# (an empty path always "exists" as the docroot directory, so the passthrough
# would silently swallow every subdomain request first).
RewriteCond %{HTTP_HOST} ^([a-z0-9-]+)\.somahub\.top$ [NC]
RewriteRule ^$ site.php?school=%1 [L,QSA]

# Real files/folders that exist (css, images, other scripts, /admin/, /dashboard/, etc.)
# — applies on any host, subdomain or not, for any path other than the bare root above
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Also allow /schoolname style paths as a fallback if wildcard DNS/hosting isn't working
# e.g. somahub.top/s/kinangoppride
RewriteRule ^s/([a-z0-9-]+)/?$ site.php?school=$1 [L,QSA]

# Blog post clean URLs: /blog/some-post-slug -> blog/post.php?slug=some-post-slug
# (/blog/ itself already resolves to blog/index.php via the real-file/folder rule above)
RewriteRule ^blog/([a-z0-9-]+)/?$ blog/post.php?slug=$1 [L,QSA]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
